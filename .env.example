# Env vars named by data-repository/endpoints/endpoints.yaml.
# api_key_env and ${VAR} tokens in that file are what a call reads.
# `corallab check-env` reports which of those names are set. Values are never printed.
#
# A model id in a run manifest must be a key under models: in endpoints.yaml.

# Azure OpenAI resource used by the azure-default endpoint.
# Get these from the Azure Portal → your OpenAI resource → Keys and Endpoint.
# Resource root only — do not append /openai/v1. Foundry's portal copies that
# suffix; LiteLLM's azure/ client adds /openai/deployments/{model}/... itself
# and 404s if the suffix is already on the base. The registry also strips it.
# The API version is api_version on the endpoint in endpoints.yaml, not an env var.
AZURE_API_KEY=
AZURE_API_BASE=https://your-resource.openai.azure.com/

# Azure AI Foundry (Claude on Azure) — azure-foundry-anthropic endpoint.
# AZURE_AI_API_BASE=
# AZURE_AI_API_KEY=

# Gemini API — gemini-direct endpoint.
# A GCP API key restricted to "Gemini API" (a.k.a. Generative Language API).
# GEMINI_API_KEY=

# LiteLLM proxy — litellm-proxy endpoint.
# LITELLM_API_BASE=http://localhost:4000
# LITELLM_API_KEY=

# Example: a second Azure resource for quota separation (see the commented
# azure-secondary endpoint in endpoints.yaml).
# AZURE_SECONDARY_API_KEY=
# AZURE_SECONDARY_API_BASE=https://your-secondary-resource.openai.azure.com/
